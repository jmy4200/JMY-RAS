# Local development defaults. Do not put secrets in this file.
JMY_HOST=127.0.0.1
JMY_PORT=8000
JMY_DATABASE_PATH=./jmy_ras.db

# Optional owner administration. Generate with: python -m backend.owner_password
# Keep the generated PBKDF2 hash private; never commit your real .env file.
JMY_OWNER_PASSWORD_HASH=
